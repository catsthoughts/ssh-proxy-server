{
  "listen": "localhost:2222",
  "key": "./ssh_host_key",
  "log_level": "info",
  "recordings_dir": "./recordings",
  "authorized_keys": "./authorized_keys",
  "auto_accept_client_keys": true,
  "allow_direct_commands": false,
  "insecure_ignore_hostkey": false,
  "recording_format": "asciinema",
  "retries": 0,
  "connect_timeout_seconds": 10,
  "known_hosts": "",
  "sftp_enabled": false,
  "static_routing": {
    "enabled": false,
    "servers": [
      "primary-target:22",
      "backup-target:22"
    ],
    "mode": "failover"
  },
  "access_control": {
    "enabled": false,
    "default": "deny",
    "rules": [
      { "user": "alice", "targets": ["web-*.prod.example.com", "db.example.com:5433"] },
      { "user": "deploy-*", "targets": ["*"] },
      { "groups": ["ssh-admins"], "targets": ["10.0.0.0/8", "192.168.1.0/24"] }
    ]
  },
  "rate_limit": {
    "enabled": false,
    "max_per_minute": 30
  },
  "metrics": {
    "enabled": false,
    "listen": "127.0.0.1:9090",
    "path": "/metrics"
  },
  "health": {
    "enabled": false,
    "listen": "127.0.0.1:9091",
    "path": "/healthz"
  },
  "recordings": {
    "retention_days": 0,
    "integrity": false
  },
  "sso": {
    "enabled": false,
    "provider": "keycloak",
    "base_url": "https://localhost:8443",
    "realm": "ssh-proxy-server",
    "client_id": "ssh-proxy-server",
    "client_secret": "",
    "scope": "openid",
    "auth_timeout_seconds": 120,
    "poll_interval_seconds": 5,
    "connect_timeout_seconds": 10,
    "enforce_ssh_user_match": true,
    "insecure_skip_verify": false,
    "required_groups": []
  }
}
